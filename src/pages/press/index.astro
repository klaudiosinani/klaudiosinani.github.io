---
import { SITE } from "@config/site";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import { featuredPressRetrievalService } from "@features/press/FeaturedPressRetrievalService";
import FeaturedPressCard from "@features/press/components/FeaturedPressCard";

const featuredPress = await featuredPressRetrievalService.retrieve();
---

<Layout title={`In the Press - ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="In the Press"
    pageDesc="Featured articles and media coverage for my Open-Source Software work"
  >
    <ul>
      {
        featuredPress.map(press => (
          <FeaturedPressCard
            publicationTitle={press.publicationTitle}
            publisherName={press.publisherName}
            publicationUrl={press.publicationUrl}
            softwareTitle={press.softwareTitle}
            softwareRepositoryUrl={press.softwareRepositoryUrl}
          />
        ))
      }
    </ul>
    <br />
  </Main>
  <Footer />
</Layout>
