---
import { RoutePathResolver } from "@utils/routing/RoutePathResolver";
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@features/publication/components/Card";
import Pagination from "@features/pagination/components/Pagination.astro";
import { SITE } from "@config/site";

export interface Props {
  currentPage: number;
  totalPages: number;
  items: CollectionEntry<"blog">[];
  prevUrl: string;
  nextUrl: string;
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, items, prevUrl, nextUrl, tag, tagName } =
  Astro.props;
---

<Layout title={`Index: ${tagName} - ${SITE.title}`}>
  <Header activeNav="tags" />
  <Main
    pageTitle={[`Index:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All publications with the keyword "${tagName}".`}
  >
    <h1 slot="title" transition:name={tag}>{`Index:${tag}`}</h1>
    <ul>
      {
        items.map(({ data, slug }) => (
          <Card
            href={RoutePathResolver.resolvePublication(slug)}
            frontmatter={data}
          />
        ))
      }
    </ul>
  </Main>

  <Pagination {currentPage} {totalPages} {prevUrl} {nextUrl} />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
