---
import { ROUTES } from "@config/routes";
import { SITE } from "@config/site";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import FeaturedSoftwareCard from "@features/software/components/FeaturedSoftwareCard";
import { featuredSoftwareRetrievalService } from "@features/software/FeaturedSoftwareRetrievalService";
import LinkButton from "@components/LinkButton.astro";
import ArrowRightIcon from "@components/icons/ArrowRightIcon";

const featuredSoftware = await featuredSoftwareRetrievalService.retrieve();
---

<Layout title={`Software - ${SITE.title}`}>
  <Header activeNav="software" />
  <Main pageTitle="Software">
    <ul>
      {
        featuredSoftware.map(software => (
          <FeaturedSoftwareCard
            name={software.name}
            logline={software.logline}
            metadata={software.metadata}
            url={software.url}
          />
        ))
      }
    </ul>

    <div class="all-posts-btn-wrapper mt-8 text-center">
      <LinkButton href={ROUTES.softwareArchive}>
        All Software
        <ArrowRightIcon />
      </LinkButton>
    </div>

    <br />
  </Main>
  <Footer />
</Layout>
