---
import { SITE } from "@config/site";
import { SystemClock } from "@utils/datetime/SystemClock";
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

const currentYear = SystemClock.currentYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class={`${noMarginTop ? "" : "mt-auto"}`}>
  <Hr noPadding />
  <div class="footer-wrapper">
    <Socials centered />
    <div class="copyright-wrapper">
      <span>Copyright &#169; {SITE.startYear} - {currentYear}</span>
    </div>
  </div>
  <div class="footer-image-wrapper">
    <img
      src="/footer-light.png"
      alt="Dia, Liri"
      class="footer-image footer-light"
      width="2105"
      height="467"
      loading="lazy"
      decoding="async"
    />
    <img
      src="/footer-dark.png"
      alt="Dia, Liri"
      class="footer-image footer-dark"
      width="2105"
      height="467"
      loading="lazy"
      decoding="async"
    />
  </div>
</footer>

<style>
  footer {
    @apply w-full;
  }
  .footer-wrapper {
    @apply flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4;
  }
  .footer-image-wrapper {
    @apply flex flex-col items-center pb-4 pt-0;
  }
  .footer-image {
    width: 80%;
    display: none;
  }
  html[data-theme="light"] .footer-light {
    display: block;
  }
  html[data-theme="dark"] .footer-dark {
    display: block;
  }
  .copyright-wrapper {
    @apply my-2 flex flex-col items-center whitespace-nowrap sm:flex-row;
  }
</style>
