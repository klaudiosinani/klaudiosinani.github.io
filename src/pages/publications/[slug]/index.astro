---
import { ROUTES } from "@config/routes";
import { type CollectionEntry, getCollection } from "astro:content";
import Posts from "@features/publication/layouts/Posts.astro";
import PostDetails from "@features/publication/layouts/PostDetails.astro";
import { PublicationQueryService } from "@features/publication/PublicationQueryService";
import { paginationService } from "@features/pagination/PaginationService";

export interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  const postResult = posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));

  const pagePaths = paginationService
    .subsequentPageNumbers(posts.length)
    .map(pageNumber => ({
      params: { slug: String(pageNumber) },
    }));

  return [...postResult, ...pagePaths];
}

const { slug } = Astro.params;
const { post } = Astro.props;

const posts = await getCollection("blog");

const sortedPosts = PublicationQueryService.sortByDate(posts);

const pagination = paginationService.paginate({
  items: sortedPosts,
  page: slug,
  basePath: ROUTES.publications,
});
---

{post ? <PostDetails post={post} /> : <Posts {...pagination} />}
