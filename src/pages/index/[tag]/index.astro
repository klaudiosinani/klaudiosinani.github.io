---
import { RoutePathResolver } from "@utils/routing/RoutePathResolver";
import { getCollection } from "astro:content";
import TagPosts from "@features/publication/layouts/TagPosts.astro";
import { PublicationQueryService } from "@features/publication/PublicationQueryService";
import { paginationService } from "@features/pagination/PaginationService";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  const tags = PublicationQueryService.collectTags(posts);

  return tags.map(({ tag, tagName }) => {
    return {
      params: { tag },
      props: { tag, tagName, posts },
    };
  });
}

const { tag, tagName, posts } = Astro.props;

const postsByTag = PublicationQueryService.findByTag(posts, tag);

const pagination = paginationService.paginate({
  items: postsByTag,
  basePath: RoutePathResolver.resolveTag(tag),
  isIndex: true,
});
---

<TagPosts {...pagination} {tag} {tagName} />
