{
  "name": "klaudiosinani.com",
  "description": "Personal website of Klaudio Sinani",
  "version": "1.0.0",
  "private": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321 --strictPort false",
    "start": "astro dev",
    "prebuild": "node scripts/check-tokens.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "audit:seo": "node scripts/audit-seo.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "sync": "astro sync",
    "generate": "astro sync",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format:check": "prettier --check . --plugin=prettier-plugin-astro",
    "format": "prettier --write . --plugin=prettier-plugin-astro",
    "lint": "eslint .",
    "precheck": "npm run generate",
    "pretest": "npm run generate",
    "check:spacing": "node scripts/check-spacing.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.7",
    "@astrojs/react": "6.0.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/react-dom": "18.3.7",
    "astro": "7.2.4",
    "fuse.js": "7.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "satori": "0.33.3",
    "signale": "^1.4.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/signale": "^1.4.7",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.11",
    "astro-eslint-parser": "1.4.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@vitejs/plugin-react": "6.1.0"
  }
