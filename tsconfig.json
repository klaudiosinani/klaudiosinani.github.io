{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "baseUrl": "source",
    "jsx": "react-jsx",
    "paths": {
      "@core/*": ["core/*"],
      "@app/*": ["app/*"],
      "@bindings": ["app/injection/ApplicationKeys.ts"],
      "@ui/*": ["ui/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["dist", "node_modules", ".astro", "coverage",
    "source/pages"
  ]
}
