---
import type { BreadcrumbStep } from "@app/util/seo/breadcrumb/BreadcrumbStep";
import { BREADCRUMB_HOME } from "@app/configuration/navigation/BreadcrumbHome";
import type { StructuredData } from "@app/util/seo/StructuredData";
import "@ui/style/base.css";
import { LOCALE } from "@app/configuration/site/SiteLocale";
import { SITE } from "@app/configuration/site/Site";

import { CONTEXT } from "@app/ApplicationContext.ts";
import { BlogPostingSchemaBuilder } from "@app/util/seo/article/BlogPostingSchemaBuilder.ts";
import { BreadcrumbListSchemaBuilder } from "@app/util/seo/breadcrumb/BreadcrumbListSchemaBuilder.ts";
import { PageBreadcrumbsResolver } from "@app/util/seo/breadcrumb/PageBreadcrumbsResolver.ts";

const BLOG_POSTING_SCHEMA_BUILDER: BlogPostingSchemaBuilder = CONTEXT.resolve(BlogPostingSchemaBuilder);
const BREADCRUMB_LIST_SCHEMA_BUILDER: BreadcrumbListSchemaBuilder = CONTEXT.resolve(BreadcrumbListSchemaBuilder);
const PAGE_BREADCRUMBS_RESOLVER: PageBreadcrumbsResolver = CONTEXT.resolve(PageBreadcrumbsResolver);

const googleSiteVerification: string = SITE.getGoogleSiteVerification();

export interface Props {
    title?: string;
    author?: string;
    profile?: string;
    description?: string;
    ogImage?: string;
    canonicalURL?: string;
    pubDatetime?: Date;
    modDatetime?: Date | null;
    scrollSmooth?: boolean;
    ogType?: "website" | "article";
    schema?: StructuredData[];
    breadcrumbs?: BreadcrumbStep[];
    noindex?: boolean;
    tags?: readonly string[];
    lang?: string;
    alternates?: readonly { tag: string; href: string }[];
}

const {
    title = SITE.getTitle(),
    author = SITE.getAuthor(),
    profile = SITE.getProfile(),
    description = SITE.getDesc(),
    ogImage = SITE.getOgImage(),
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
    pubDatetime,
    modDatetime,
    scrollSmooth = false,
    ogType = "website",
    schema,
    breadcrumbs,
    noindex = false,
    tags = [],
    lang,
    alternates = [],
} = Astro.props;

const socialImageURL: string = new URL(ogImage ?? SITE.getOgImage() ?? "og.png", Astro.url.origin).href;

const described: StructuredData[] =
    schema ??
    (pubDatetime
        ? [
              BLOG_POSTING_SCHEMA_BUILDER.build({
                  headline: title,
                  image: socialImageURL,
                  author,
                  profile,
                  pubDatetime,
                  modDatetime,
              }),
          ]
        : []);

const trail: BreadcrumbStep[] =
    breadcrumbs ?? PAGE_BREADCRUMBS_RESOLVER.resolve(Astro.url.pathname, SITE.getWebsite(), BREADCRUMB_HOME);

const structuredData: StructuredData[] = [
    ...described,
    ...(trail.length > 0 ? [BREADCRUMB_LIST_SCHEMA_BUILDER.build(trail)] : []),
];
---

<!doctype html>
<html lang={lang ?? LOCALE.getLanguage() ?? "en"} class={scrollSmooth ? "scroll-smooth" : undefined}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="icon" type="image/png" sizes="180x180" href="/favicon-180.png" />
        <link rel="canonical" href={canonicalURL} />

        {
            alternates.map(({ tag, href }: { tag: string; href: string }) => (
                <link rel="alternate" hreflang={tag} href={new URL(href, Astro.site).href} />
            ))
        }
        {
            alternates.length > 0 && (
                <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, Astro.site).href} />
            )
        }
        <meta name="generator" content={Astro.generator} />
        {
            noindex ? (
                <meta name="robots" content="noindex, follow" />
            ) : (
                <meta
                    name="robots"
                    content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
                />
            )
        }

        <script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>

        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="author" content={author} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="alternate" type="application/rss+xml" title={`${SITE.getTitle()} - Publications`} href="/rss.xml" />
        <link rel="alternate" type="application/rss+xml" title={`${SITE.getTitle()} - Releases`} href="/releases.xml" />
        <link
            rel="alternate"
            type="application/feed+json"
            title={`${SITE.getTitle()} - Publications`}
            href="/feed.json"
        />

        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE.getTitle()} />
        <meta property="og:locale" content={LOCALE.getOgLocale()} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
        <meta property="og:image:type" content="image/png" />

        {
            ogType === "article" && pubDatetime && (
                <meta property="article:published_time" content={pubDatetime.toISOString()} />
            )
        }
        {
            ogType === "article" && modDatetime && (
                <meta property="article:modified_time" content={modDatetime.toISOString()} />
            )
        }
        {modDatetime && <meta property="og:updated_time" content={modDatetime.toISOString()} />}
        {ogType === "article" && <meta property="article:author" content={author} />}
        {tags.map((tag: string) => <meta property="article:tag" content={tag} />)}

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />
        <meta property="twitter:image:alt" content={title} />

        {
            structuredData.map((entry: StructuredData) => (
                <script type="application/ld+json" set:html={JSON.stringify(entry)} />
            ))
        }

        <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-400-latin.woff2" crossorigin />
        <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-600-latin.woff2" crossorigin />

        <meta name="theme-color" content="rgb(251, 254, 251)" />

        {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

        <script is:inline src="/toggle-theme.js"></script>
    </head>
    <body>
        <slot />
    </body>
</html>
