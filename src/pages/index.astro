---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import ArrowRightIcon from "@components/icons/ArrowRightIcon";
import Card from "@features/publication/components/Card";
import { PublicationQueryService } from "@features/publication/PublicationQueryService";
import { ROUTES } from "@config/routes";
import { POSTS_PER_INDEX } from "@config/content";
import { RoutePathResolver } from "@utils/routing/RoutePathResolver";

const posts = await getCollection("blog");

const sortedPosts = PublicationQueryService.sortByDate(posts);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content">
    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>Publications</h2>
          <ul>
            {recentPosts.map(
              ({ data, slug }, index) =>
                index < POSTS_PER_INDEX && (
                  <Card
                    href={RoutePathResolver.resolvePublication(slug)}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper">
      <LinkButton href={`${ROUTES.publications}/`}>
        All Publications
        <ArrowRightIcon />
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Featured & Recent Posts Sections ===== */
  #featured,
  #recent-posts {
    @apply pb-6 pt-12;
  }
  #featured h2,
  #recent-posts h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
</style>
